{
  "name": "lantern-street",
  "main": "src/worker.js",
  "compatibility_date": "2025-10-01",
  // 画面は Astro で dist/ に書き出してから配信する（wrangler dev / deploy の前に自動でビルド）
  "build": { "command": "npm run build" },
  // 画面のファイルがあっても先に Worker を通す（workers.dev では画面を出さないため）
  "assets": { "directory": "./dist", "binding": "ASSETS", "run_worker_first": true },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "lantern-street",
      "database_id": "a03563bd-5ecb-4bb4-8789-7a9081805b0b",
      // ローカル（wrangler dev）では本番と別の、テスト用のデータベースを使う
      "preview_database_id": "00000000-0000-0000-0000-000000000000"
    }
  ]
}
